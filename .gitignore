# Environment
.env
.env.local

# Dependencies / runtime
/vendor/
composer.lock

# Storage
/storage/logs/*
/storage/uploads/*
/storage/exports/*
/storage/tenants/*
/storage/mail/*
/storage/rate_limits/*
!/storage/logs/.gitkeep
!/storage/uploads/.gitkeep
!/storage/exports/.gitkeep
!/storage/tenants/.gitkeep
!/storage/mail/.gitkeep
!/storage/rate_limits/.gitkeep

# Public media (imported textures)
/public/media/tenants/*
!/public/media/.gitkeep
!/public/media/tenants/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Test artifacts
/tests/output/
.phpunit.result.cache

# Server-generated logs
/error_log
