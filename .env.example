APP_NAME=FMOS
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# 32+ char secret for field encryption (PAN/GSTIN). Generate a unique value per environment.
APP_KEY=
# Optional break-glass for POST /api/v1/tenants (leave empty to disable)
BOOTSTRAP_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fmos_v9
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=fmos_session
SESSION_LIFETIME=7200

STORAGE_PATH=storage
LOG_LEVEL=debug

# Mail: log (default, writes storage/mail) or smtp
# Production MUST use MAIL_DRIVER=smtp with real credentials.
# Do NOT quote values: use MAIL_DRIVER=smtp  (not MAIL_DRIVER="smtp")
MAIL_DRIVER=log
# MilesWeb / cPanel typical outgoing settings (confirm in cPanel → Email → Connect Devices):
# MAIL_HOST=mail.fmos.in
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# OR: MAIL_PORT=465 + MAIL_ENCRYPTION=ssl
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# cPanel mail certs often do not match mail.domain.com; keep false unless you have a valid cert.
MAIL_SSL_VERIFY=false
# Username should be the full mailbox address, e.g. accounts@fmos.in
# Password must be that mailbox password (not cPanel login), unless using an SMTP token.
# When smtp connect fails: write to storage/mail only if APP_ENV is not production
# (or force with MAIL_FALLBACK_LOG=true). Never enables silent “success” for SMTP.
MAIL_FALLBACK_LOG=true
MAIL_FROM_NAME=FMOS
# Optional override for auth From (defaults to MAIL_FROM_ACCOUNTS)
MAIL_FROM_ADDRESS=
# Only for local automated tests — never enable in staging/production
MAIL_EXPOSE_TOKENS=false

# FMOS mailbox map (fmos.in)
MAIL_FROM_ACCOUNTS=accounts@fmos.in
MAIL_FROM_NOREPLY=no-reply@fmos.in
MAIL_REPLY_TO=support@fmos.in
MAIL_SUPPORT=support@fmos.in
MAIL_BILLING=billing@fmos.in
MAIL_SALES=sales@fmos.in
MAIL_PRIVACY=privacy@fmos.in
MAIL_LEGAL=legal@fmos.in
MAIL_SECURITY=security@fmos.in
MAIL_ABUSE=abuse@fmos.in

# Comma-separated extra browser origins (APP_URL is always allowed)
CORS_ALLOWED_ORIGINS=

EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_MIN_LENGTH=12
